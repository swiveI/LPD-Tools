---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "VPM package listing" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Fonts: all from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;62..125,700&family=JetBrains+Mono:wght@400&display=swap"
    />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}LPD Shield.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}LPD Shield.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}LPD Shield.png`} />
  </head>
  <body class="bg-[var(--color-void)] min-h-screen antialiased overflow-x-hidden">
    <!-- --- Skip link --- -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-electric)] focus:text-[var(--color-void)] focus:rounded-[9px] focus:font-bold focus:outline-none focus:ring-2 focus:ring-white"
    >
      Skip to main content
    </a>
    <main id="main-content" class="relative z-10" role="main">
      <slot />
    </main>
  </body>
</html>
